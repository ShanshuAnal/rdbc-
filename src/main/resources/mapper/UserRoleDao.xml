<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jiege.community.dao.UserRoleDao">

    <resultMap id="UserResultMap" type="com.jiege.community.entity.UserRole">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="role_id" property="roleId" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="userRoleColumn">
        id,
        user_id,
        role_id
    </sql>

    <update id="batchInsert">
        INSERT INTO sys_user_role
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">
                user_id,
            </if>
            <if test="roleId != null">
                role_id
            </if>
        </trim>
        VALUES
        <foreach collection="userRoleList" item="item" separator=",">
            (#{item.userId}, #{item.roleId})
        </foreach>

    </update>

    <delete id="deleteByUserId">
        DELETE
        FROM sys_user_role
        WHERE user_id = #{userId}
    </delete>

    <select id="selectRoles" resultType="java.lang.String">
        SELECT
        <include refid="userRoleColumn"/>
        FROM sys_user_role
        where user_id = #{userId}
        ORDER BY id
    </select>

</mapper>